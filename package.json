{
  "name": "friendly-task-reminder",
  "version": "0.0.0",
  "description": "Local-first desktop task transition reminder app.",
  "main": "electron/main.cjs",
  "engines": {
    "node": "26.2.0",
    "npm": "11.16.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "npm run build && npm run electron",
    "web": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "e2e:break-conflict": "playwright test -c e2e/playwright.break-conflict.config.mjs",
    "guide:screens": "node scripts/capture-user-guide-screenshots.cjs",
    "guide:preview": "node scripts/render-user-guide-preview.cjs",
    "guide:refresh": "npm run guide:screens && npm run guide:preview",
    "release:patch": "node scripts/release-tag.cjs patch",
    "release:minor": "node scripts/release-tag.cjs minor",
    "release:major": "node scripts/release-tag.cjs major",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "prettier --check .",
    "electron": "node scripts/run-electron.cjs",
    "electron:smoke": "ng build && node scripts/run-electron.cjs --smoke-test",
    "package:dir": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win portable",
    "package:installer": "npm run build && electron-builder --win nsis"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "21.2.15",
    "@angular/compiler": "21.2.15",
    "@angular/core": "21.2.15",
    "@angular/forms": "21.2.15",
    "@angular/platform-browser": "21.2.15",
    "@angular/router": "21.2.15",
    "chart.js": "4.5.1",
    "ng2-charts": "8.0.0",
    "papaparse": "5.5.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.13",
    "@angular/cli": "21.2.13",
    "@angular/compiler-cli": "21.2.15",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@playwright/test": "1.60.0",
    "electron": "42.3.0",
    "electron-builder": "26.8.1",
    "jsdom": "29.1.1",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  },
  "overrides": {
    "tar": "7.5.15",
    "tmp": "0.2.7"
  },
  "build": {
    "appId": "local.assistant-time.time-assistant",
    "productName": "Time Assistant",
    "files": [
      "dist/friendly-task-reminder/browser/**/*",
      "electron/**/*",
      "artifacts/*.png",
      "build-resources/app-icon.ico",
      "src/assets/icons/app-icon.png",
      "src/assets/icons/app-icon-notification.png",
      "package.json"
    ],
    "directories": {
      "buildResources": "build-resources",
      "output": "release"
    },
    "win": {
      "icon": "src/assets/icons/app-icon.png",
      "target": "portable"
    },
    "portable": {
      "artifactName": "${productName}.exe"
    }
  }
}
